# ==========================================
# Disaster Management & Relief Coordination
# Master Environment Configuration Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Configuration
# Local Community Edition or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/disaster_management_db
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/disaster_management_test_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_disaster_relief_2026_at_least_32_chars
JWT_EXPIRES_IN=7d

# Machine Learning Service Integration
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=5000

# File Upload Settings (Local disk or S3 compatible)
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=./uploads

# Python ML Service Configuration
ML_PORT=8000
ML_HOST=127.0.0.1
DEBUG_MODE=True
